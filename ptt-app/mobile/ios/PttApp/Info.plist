<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ── App identity ─────────────────────────────────────────────── -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>PTT Walkie</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>PttApp</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleVersion</key>
  <string>1</string>

  <!-- ── Permissions ──────────────────────────────────────────────── -->
  <key>NSMicrophoneUsageDescription</key>
  <string>PTT Walkie needs microphone access to transmit your voice during push-to-talk and calls.</string>

  <key>NSCameraUsageDescription</key>
  <string>PTT Walkie needs camera access for video calls.</string>

  <key>NSContactsUsageDescription</key>
  <string>PTT Walkie reads your contacts to show which of them are on the app.</string>

  <!-- Required for BLE PTT accessories and hardware PTT buttons -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>PTT Walkie uses Bluetooth to connect to external PTT buttons and accessories.</string>
  <!-- Legacy key required for iOS 12 and earlier -->
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>PTT Walkie uses Bluetooth to connect to external PTT buttons and accessories.</string>

  <!-- VoIP background mode — keeps socket alive and enables CallKit push -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>voip</string>
    <string>fetch</string>
    <string>remote-notification</string>
  </array>

  <!-- ── CallKit / VoIP ────────────────────────────────────────────── -->
  <!-- Required for CallKit to display incoming call UI -->
  <key>UISupportsDocumentBrowser</key>
  <false/>

  <!-- ── Orientation ───────────────────────────────────────────────── -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- ── Metro / React Native dev ─────────────────────────────────── -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- Allow localhost during development; tighten for production -->
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>

</dict>
</plist>
