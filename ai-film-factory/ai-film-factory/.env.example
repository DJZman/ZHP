# SQL Server
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=YourDatabase
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_TRUST_CERT=yes

# OpenAI
OPENAI_API_KEY=sk-...

# Kling providers
NOVITA_API_KEY=novita-...
PIAPI_API_KEY=piapi-...

# ElevenLabs
ELEVEN_API_KEY=eleven-...

# Storage (R2 or S3-compatible)
STORAGE_PROVIDER=S3
S3_ENDPOINT_URL=https://<your-r2-endpoint>  # e.g., https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ai-film-factory
